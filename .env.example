# ─────────────────────────────────────────────────────────────
# 실전 (실제 돈) — 지금은 안 쓴다. 데모 검증이 끝난 뒤에.
# ─────────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ─────────────────────────────────────────────────────────────
# 현물 데모(테스트넷) — https://testnet.binance.vision
#   GitHub 로그인 → Generate HMAC_SHA256 Key
#   HIBERNATE / SURFER 가 쓰는 것은 이쪽이다.
# ─────────────────────────────────────────────────────────────
BINANCE_SPOT_TESTNET_KEY=
BINANCE_SPOT_TESTNET_SECRET=

# ─────────────────────────────────────────────────────────────
# 선물 데모(테스트넷) — https://testnet.binancefuture.com
#   지금 전략들은 전부 현물이라 필요 없다. 나중에 선물 전략을 하면 채운다.
# ─────────────────────────────────────────────────────────────
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

LOG_FILENAME=runner.log
